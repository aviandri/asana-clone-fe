# Rendered by the nginx image's envsubst step (/etc/nginx/templates) — ${BACKEND_URL} is substituted.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # JSON and everything else; only the attachment upload routes below accept more.
    client_max_body_size 2m;
    # Max gap between two reads of a request body (nginx's default, made explicit): a client that
    # stalls longer gets 408, so a trickled body can't hold a connection open indefinitely.
    client_body_timeout 60s;

    # Behind Cloudflare or a load balancer? Every proxy below sends X-Forwarded-For: $remote_addr
    # (SPEC §14 M2), which would then be the proxy's address, putting all clients in one rate-limit
    # bucket. Restore the client address first; see "Upgrading to v1.4" in the BE repo's deploy/README.md.
    # set_real_ip_from 173.245.48.0/20;    # your proxy's CIDR(s), one line each; never 0.0.0.0/0
    # real_ip_header CF-Connecting-IP;     # Cloudflare
    # # or, behind a load balancer that appends to X-Forwarded-For:
    # real_ip_header X-Forwarded-For;
    # real_ip_recursive on;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Attachment uploads (SPEC §13): POST /tasks/:id/attachments[?draft=true] and …/attachments/link.
    # The backend enforces 100 MB per file (MAX_UPLOAD_BYTES) and answers its own 413; 105m leaves
    # room for multipart overhead. Bodies stream to the backend as they arrive instead of being
    # spooled to disk first, so it can abort an oversized upload early. Regex locations win over
    # the /api/ prefix below; BACKEND_URL must have no path part here (nginx rejects one).
    location ~ ^/api/v1/tasks/[^/]+/attachments(/link)?$ {
        client_max_body_size 105m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The rest of the API: 2m bodies, buffered by nginx before they reach the backend.
    location /api/ {
        proxy_read_timeout 300s;
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass ${BACKEND_URL};
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # MCP (SPEC §14 M5): JSON-RPC over Streamable HTTP, nothing buffered or cached either way.
    location = /mcp {
        client_max_body_size 1m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 60s;
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OAuth 2.1 for claude.ai connectors (§14): the authorization server lives in the backend.
    location /oauth/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OAuth discovery (M5): /.well-known/oauth-* is the backend's; anything else there is a 404, not the SPA.
    location ^~ /.well-known/oauth- {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /.well-known/ {
        return 404;
    }

    # The OAuth consent page (M4): never framed (clickjacking). Headers, because a <meta> CSP can't
    # set frame-ancestors. index.html is served from this location (try_files with a file, not a
    # URI fallback, so no internal redirect drops the headers).
    location ^~ /connect/ {
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options DENY always;
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    # Vite emits content-hashed filenames, so these can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: unknown paths (e.g. /projects/123, /invite/<token>) render index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
