# Rendered by the nginx image's envsubst step (/etc/nginx/templates) — ${BACKEND_URL} is substituted.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # JSON and everything else; uploads get their own limit on /api/ below.
    client_max_body_size 2m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        # Attachments (SPEC §13): the backend enforces 100 MB per file and answers 413 itself; this
        # leaves room for multipart overhead. JSON routes keep the backend's own small bodyLimit.
        client_max_body_size 105m;
        # Stream request bodies to the backend as they arrive instead of spooling them to disk
        # first, so the backend sees upload progress and can abort an oversized upload early.
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass ${BACKEND_URL};
    }

    # Vite emits content-hashed filenames, so these can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: unknown paths (e.g. /projects/123, /invite/<token>) render index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
